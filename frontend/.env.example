# Base URL of the Flask API the frontend talks to.
VITE_API_URL=http://localhost:5000

# Google OAuth Client ID (Web application) from Google Cloud Console.
# Must match GOOGLE_CLIENT_ID in backend/.env. Leave blank to hide Google sign-in.
# NOTE: in the Docker deploy this is passed as a build ARG (see docker-compose),
# because frontend/.env is not copied into the image.
VITE_GOOGLE_CLIENT_ID=

# Sentry (frontend error monitoring). Leave blank to disable.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0

# ─── Analytics (funnel measurement) ────────────────────────────────────────
# Leave BOTH blank to disable: no third-party script is loaded at all.
# Plausible: your site's domain exactly as registered there (no https://).
VITE_PLAUSIBLE_DOMAIN=
# Defaults to Plausible's hosted *manual* script, which is what lets this SPA
# count one pageview per route change. Point at your own instance if self-hosting.
VITE_PLAUSIBLE_SRC=https://plausible.io/js/script.manual.js
# PostHog (optional, instead of or alongside Plausible).
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# true → log events to the browser console instead of sending them.
VITE_ANALYTICS_DEBUG=false
