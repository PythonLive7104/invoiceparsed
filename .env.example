# Root Compose environment — copy to .env next to docker-compose.yml.
#
#   cp .env.example .env && nano .env
#
# This file configures the *stack* (database credentials, TLS domain, frontend
# build args). Application secrets — OpenAI, Paystack, Resend, JWT — live in
# backend/.env instead.

# ─── Database (the bundled Postgres) ─────────────────────────────────────────
# Postgres runs as the "db" service and is NOT published to the host, so it's
# only reachable from the other containers. Still: set a real password for
# anything you care about. docker-compose.yml builds the backend's DATABASE_URL
# from these three values.
#   python3 -c "import secrets;print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=invoiceparsed
# Rarely need changing — the compose defaults match these.
# POSTGRES_USER=invoiceparsed
# POSTGRES_DB=invoiceparsed

# ─── TLS (only with docker-compose.prod.yml) ─────────────────────────────────
# The domain Caddy obtains a Let's Encrypt certificate for. Its DNS A record
# must already point at this server, and ports 80 + 443 must be open.
# SITE_DOMAIN=invoiceparsed.com

# ─── Frontend build args ─────────────────────────────────────────────────────
# Vite bakes VITE_* values into the bundle at BUILD time, so changing any of
# these needs `docker compose up -d --build` — a restart won't pick them up.
# Google sign-in: the button only renders when this is set.
VITE_GOOGLE_CLIENT_ID=
# Error monitoring (frontend). Blank = disabled.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
# Analytics. Blank = no third-party script is loaded at all.
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_SRC=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# ─── Compose file selection ──────────────────────────────────────────────────
# Persist extra overrides instead of passing -f every time. For TLS via Caddy:
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
