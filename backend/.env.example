# ─── OpenAI ──────────────────────────────────────────────────────────────
# Your OpenAI API key. Used by the /api/extract endpoint for invoice parsing.
OPENAI_API_KEY=sk-...
# Default vision model for all document types. gpt-4o-mini is much cheaper;
# gpt-4o is more accurate. Override per document type if needed:
#   MODEL_INVOICE=gpt-4o-mini
#   MODEL_RECEIPT=gpt-4o-mini
#   MODEL_STATEMENT=gpt-4o    # keep statements on the stronger model if mini slips
OPENAI_MODEL=gpt-4o-mini

# ─── Auth ────────────────────────────────────────────────────────────────
# Secret used to sign JWT tokens. Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# ─── Admin dashboard (/admin) ──────────────────────────────────────────────
# HTTP Basic Auth credentials for the Flask-Admin UI. Leave blank to disable.
ADMIN_USER=
ADMIN_PASSWORD=

# ─── Database ────────────────────────────────────────────────────────────
# The app's own Postgres — the "db" service in docker-compose.yml. Credentials
# come from the root .env (POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB).
DATABASE_URL=postgresql://invoiceparsed:invoiceparsed@db:5432/invoiceparsed
#
# Running `python app.py` on your machine instead of in Docker? "db" won't
# resolve from the host. Publish the port once:
#     docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d db
# then use localhost, or SQLite for no setup at all:
#     DATABASE_URL=postgresql://invoiceparsed:invoiceparsed@localhost:5432/invoiceparsed
#     DATABASE_URL=sqlite:///invoiceparsed.db
#
# Legacy: SUPABASE_URL is still honoured, but only when DATABASE_URL is unset.
# SUPABASE_URL=

# ─── CORS / app URL ──────────────────────────────────────────────────────
# Origin of the React frontend that is allowed to call this API.
FRONTEND_ORIGIN=http://localhost:5173
# Public URL of the frontend, used to build links in emails (defaults to FRONTEND_ORIGIN).
APP_URL=http://localhost:5173

# ─── Google sign-in ──────────────────────────────────────────────────────
# OAuth 2.0 Client ID from Google Cloud Console (Web application). The SAME
# value must be set as VITE_GOOGLE_CLIENT_ID in frontend/.env. Leave blank to
# disable Google sign-in (the button is hidden).
GOOGLE_CLIENT_ID=

# ─── Resend (transactional email) ─────────────────────────────────────────
# API key from https://resend.com. Required for password-reset & verification.
RESEND_API_KEY=
# Verified sender. Use onboarding@resend.dev for testing, or your own domain.
# MUST use a domain you have verified at resend.com/domains. The shared
# sandbox sender (onboarding@resend.dev) is NOT usable in production: Resend
# refuses it with a 403 for any recipient other than the account owner, so
# every verification and reset email to a real user silently fails - and an
# email/password account cannot sign in until it is confirmed.
RESEND_FROM=InvoiceParsed <noreply@yourdomain.com>

# ─── Sentry (error monitoring) ─────────────────────────────────────────────
# Backend DSN from sentry.io. Leave blank to disable. Frontend uses its own
# VITE_SENTRY_DSN (set as a build arg / in the root compose .env).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0

# ─── Try-before-signup demo ────────────────────────────────────────────────
# Lets a visitor run ONE real extraction from the landing page with no account.
# The result is shown in full but exports are gated behind signup, and it's held
# server-side so the new account adopts it instead of re-uploading.
# Set DEMO_ENABLED=false to switch the whole thing off (the widget disappears).
DEMO_ENABLED=true
# Hard per-IP lifetime cap. Stored as a salted hash of the address, and it
# survives restarts and result purges, so raising it is the only way to reset.
DEMO_FREE_EXTRACTIONS=1
# Unclaimed demo results + their uploaded files are deleted after this long.
DEMO_RETENTION_HOURS=24
# Burst limit on the demo endpoint, on top of the per-IP cap above.
RATELIMIT_DEMO=6 per hour

# ─── Bachs (payment provider) ───────────────────────────────
# The only payment provider. Leave BACHS_SECRET_KEY blank for demo mode.
#
# Use the sandbox while developing: keys only work against their own
# environment, so an sk_sandbox_ key with the live API base returns 401.
#   sandbox: BACHS_SECRET_KEY=sk_sandbox_...  BACHS_API_BASE=https://sandbox-api.bachs.io
#   live:    BACHS_SECRET_KEY=sk_live_...     BACHS_API_BASE=https://api.bachs.io
BACHS_SECRET_KEY=
BACHS_API_BASE=https://api.bachs.io

# Webhook signing secret, which is NOT the API key. Each webhook endpoint has
# its own, found at Developer Portal > Webhooks > <endpoint> > Signing secret
# (reveal it first - copying the masked value silently fails every delivery).
# Register the endpoint as:  https://<your-domain>/api/billing/webhook
# Note this is the apex domain, not an api. subdomain: nginx proxies /api/ on
# the same host that serves the app.
BACHS_WEBHOOK_SECRET=

# Replay window for webhook timestamps, in seconds. Bachs' own samples use 300.
BACHS_WEBHOOK_TOLERANCE=300

# Recurring product ids, one per paid tier. Bachs has no "plan" objects and no
# create-subscription endpoint: a subscription only exists once a checkout
# containing a recurring product completes. Create three products in the
# dashboard with billing_cycle {interval: month, frequency: 1} and paste the
# prod_... ids here. Subscriptions currently bill USD cards only.
BACHS_PRODUCT_STARTER=
BACHS_PRODUCT_PRO=
BACHS_PRODUCT_BUSINESS=

# ─── Billing demo mode ─# ─── Billing demo mode ───────────────────────────────────
# true -> /billing/checkout and /billing/upgrade switch plans instantly with no
#         payment. For local development and the hosted demo ONLY.
# false (default) -> with no payment provider configured, plan changes are
#         REFUSED (503) rather than granted. This is deliberate: a production
#         deploy that has lost or rotated out its provider key must fail closed,
#         not hand out paid plans for free. Switching down to Free always works.
BILLING_DEMO_MODE=false

# ─── Schema management ─# ─── Schema management ─────────────────────────────────────
# true  -> create any missing tables from the models at startup. Fine for host-
#          only dev and the test suite.
# false -> the schema is applied by Alembic instead (`flask db upgrade`), which
#          is what the Docker deploy does via docker_entrypoint.py.
# Leave this FALSE for any database holding real data: create_all() only ever
# adds missing tables, never a column to an existing one. See DB.md.
AUTO_CREATE_TABLES=true

# ─── Rate limiting ─────────────────────────────────────────────────────────
# Use Redis in production so limits are shared across gunicorn workers, e.g.
# RATELIMIT_STORAGE_URI=redis://localhost:6379
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=300 per minute
RATELIMIT_AUTH=10 per minute
# Per-ACCOUNT ceiling on /api/extract — a cost control, not just an abuse one.
# Every allowed call spends an OpenAI vision request, and Pro/Business have no
# monthly document limit, so under RATELIMIT_DEFAULT alone one scripted account
# could run up a very large bill in minutes. Keyed on the account, so spreading
# calls across IPs does not multiply the budget.
RATELIMIT_EXTRACT=20 per minute
# Max files accepted as the pages of ONE document. Every page is another image
# in the same model request, so the page count multiplies what one call costs.
MAX_PAGES_PER_DOC=10

# ─── Webhooks (outbound, to your users' endpoints) ────────────────────────
# Failed deliveries retry with exponential backoff (base * 2^n, capped).
WEBHOOK_MAX_ATTEMPTS=4
WEBHOOK_BACKOFF_BASE=2
WEBHOOK_BACKOFF_CAP=60
# Webhook URLs are customer-supplied and fetched from inside our own network, so
# any host resolving to a private, loopback or link-local address is refused —
# that covers the Postgres and Redis containers, this API itself, and the cloud
# instance-metadata endpoint. Checked when a webhook is saved AND on every
# delivery, so DNS cannot be re-pointed afterwards.
# Set true ONLY to test against a receiver on your own machine.
WEBHOOK_ALLOW_PRIVATE_HOSTS=false
