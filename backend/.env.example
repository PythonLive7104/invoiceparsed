# ─── OpenAI ──────────────────────────────────────────────────────────────
# Your OpenAI API key. Used by the /api/extract endpoint for invoice parsing.
OPENAI_API_KEY=sk-...
# Default vision model for all document types. gpt-4o-mini is much cheaper;
# gpt-4o is more accurate. Override per document type if needed:
#   MODEL_INVOICE=gpt-4o-mini
#   MODEL_RECEIPT=gpt-4o-mini
#   MODEL_STATEMENT=gpt-4o    # keep statements on the stronger model if mini slips
OPENAI_MODEL=gpt-4o-mini

# ─── Auth ────────────────────────────────────────────────────────────────
# Secret used to sign JWT tokens. Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# ─── Admin dashboard (/admin) ──────────────────────────────────────────────
# HTTP Basic Auth credentials for the Flask-Admin UI. Leave blank to disable.
ADMIN_USER=
ADMIN_PASSWORD=

# ─── Database ────────────────────────────────────────────────────────────
# SQLite for local dev. For production use Postgres, e.g.
# postgresql+psycopg://user:pass@host:5432/invoiceparsed
DATABASE_URL=sqlite:///invoiceparsed.db

# ─── CORS / app URL ──────────────────────────────────────────────────────
# Origin of the React frontend that is allowed to call this API.
FRONTEND_ORIGIN=http://localhost:5173
# Public URL of the frontend, used to build links in emails (defaults to FRONTEND_ORIGIN).
APP_URL=http://localhost:5173

# ─── Google sign-in ──────────────────────────────────────────────────────
# OAuth 2.0 Client ID from Google Cloud Console (Web application). The SAME
# value must be set as VITE_GOOGLE_CLIENT_ID in frontend/.env. Leave blank to
# disable Google sign-in (the button is hidden).
GOOGLE_CLIENT_ID=

# ─── Resend (transactional email) ─────────────────────────────────────────
# API key from https://resend.com. Required for password-reset & verification.
RESEND_API_KEY=
# Verified sender. Use onboarding@resend.dev for testing, or your own domain.
RESEND_FROM=InvoiceParsed <onboarding@resend.dev>

# ─── Paystack (billing) ───────────────────────────────────────────────────
# Leave PAYSTACK_SECRET_KEY blank to run billing in DEMO mode (plan changes apply
# instantly, no real payment). Set all of these for live billing.
# Keys come from Paystack Dashboard → Settings → API Keys & Webhooks. Use the
# sk_test_/pk_test_ pair against test mode. The secret key ALSO signs incoming
# webhooks, so there is no separate webhook secret to configure.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_API_BASE=https://api.paystack.co
# Must match the currency of the plans you created in Paystack.
PAYSTACK_CURRENCY=USD
# Paystack plan codes per paid plan (Dashboard → Plans; they look like PLN_xxxx).
# Create one recurring monthly plan per tier, priced to match backend/plans.py.
PAYSTACK_PLAN_STARTER=
PAYSTACK_PLAN_PRO=
PAYSTACK_PLAN_BUSINESS=

# ─── Sentry (error monitoring) ─────────────────────────────────────────────
# Backend DSN from sentry.io. Leave blank to disable. Frontend uses its own
# VITE_SENTRY_DSN (set as a build arg / in the root compose .env).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0

# ─── Rate limiting ─────────────────────────────────────────────────────────
# Use Redis in production so limits are shared across gunicorn workers, e.g.
# RATELIMIT_STORAGE_URI=redis://localhost:6379
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=300 per minute
RATELIMIT_AUTH=10 per minute

# ─── Webhooks (outbound, to your users' endpoints) ────────────────────────
# Failed deliveries retry with exponential backoff (base * 2^n, capped).
WEBHOOK_MAX_ATTEMPTS=4
WEBHOOK_BACKOFF_BASE=2
WEBHOOK_BACKOFF_CAP=60
